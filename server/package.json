{
  "name": "canaan-enquiry-server",
  "version": "1.0.0",
  "description": "Enquiry API for Canaan Third Space Senior Care Home — saves to PostgreSQL and sends SMTP email notifications.",
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "ts-node --project tsconfig.json index.ts",
    "build": "tsc",
    "prestart": "npm run build",
    "start": "cross-env NODE_ENV=production node dist/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "nodemailer": "^6.9.13",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.23.1",
    "cross-env": "^10.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  }
}
