# ============================================================
# Canaan Third Space Senior Care Home — Enquiry Server
# ============================================================
#
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it is already in .gitignore.
#
# ============================================================

# ── Server ────────────────────────────────────────────
# Port the Express server listens on.
PORT=3001

# ── CORS ────────────────────────────────────────────
# The following origins are already hardcoded in server/index.ts and
# are always allowed (they are not secrets):
#   https://canaanthirdspace.com
#   https://canaan-third-space.web.app
#   http://localhost:4321
#
# ALLOWED_ORIGIN is an ADDITIONAL slot for a staging URL or any other
# extra origin you need to allow without modifying the source code.
# Leave it unset (or blank) when not needed.
# ALLOWED_ORIGIN=https://staging.canaanthirdspace.com

# ── SMTP (email notifications) ────────────────────────────────
#
# Example: Gmail with App Password
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Create App Password:        https://myaccount.google.com/apppasswords
#    (App = Mail, Device = Other/Custom name)
# 3. Paste the 16-character password into SMTP_PASS below.
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=thirdspacecarehome@gmail.com
SMTP_PASS=your-16-char-app-password-here

# Friendly "from" name shown in the recipient's inbox
SMTP_FROM="Canaan Website Enquiry" <thirdspacecarehome@gmail.com>

# Where new enquiry notification emails should be delivered
ENQUIRY_TO_EMAIL=thirdspacecarehome@gmail.com
