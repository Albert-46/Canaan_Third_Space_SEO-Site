# ============================================================
# Canaan Third Space Senior Care Home
# Environment Variables Configuration
# ============================================================
#
# DO NOT COMMIT THIS FILE (.env) TO VERSION CONTROL.
# Copy .env.example to .env and fill in your actual credentials.

# ────────────────────────────────────────────────────────────
# [FRONTEND] Astro Build Variables
# ────────────────────────────────────────────────────────────
# These variables are safe to expose to the frontend.
# They are baked into the static HTML at build time.

# The public URL of the deployed Express backend (no trailing slash).
# Used by the contact form to submit enquiries.
# If left blank during development, it defaults to http://localhost:3001
# Example: https://api.canaanthirdspace.com
PUBLIC_API_BASE_URL=http://localhost:3001

# ────────────────────────────────────────────────────────────
# [BACKEND] Express API Variables
# ────────────────────────────────────────────────────────────
# THESE ARE SECRETS. NEVER expose them to Astro PUBLIC_ variables.
# NEVER commit them to version control.

# The port the Express server listens on (default 3001)
PORT=3001

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
# Append ?sslmode=require if your hosting platform requires SSL.
DATABASE_URL=postgresql://canaan_user:canaan_dev_pass@localhost:5432/canaan_enquiries

# Optional: Extra origin allowed to make CORS requests to the API.
# Production domains (canaanthirdspace.com, etc) and localhost are already allowed.
# Use this for staging URLs (e.g. Vercel preview URLs).
# ALLOWED_ORIGIN=https://staging.canaanthirdspace.com

# Optional: Override the location of this .env file if the runtime environment
# puts it somewhere unexpected.
# DOTENV_PATH=/absolute/path/to/custom.env

# ────────────────────────────────────────────────────────────
# [BACKEND] SMTP Email Notifications
# ────────────────────────────────────────────────────────────

# SMTP server hostname
SMTP_HOST=smtp.gmail.com

# SMTP port: 587 (STARTTLS) or 465 (SSL)
SMTP_PORT=587

# true if using port 465, false if using port 587
SMTP_SECURE=false

# Your Gmail address or SMTP username
SMTP_USER=thirdspacecarehome@gmail.com

# Your Gmail App Password (16 characters, no spaces)
# Instructions: https://myaccount.google.com/apppasswords
SMTP_PASS=REPLACE_WITH_YOUR_APP_PASSWORD

# The sender name and address displayed on the notification emails
SMTP_FROM="Canaan Website Enquiry" <thirdspacecarehome@gmail.com>

# The inbox that should receive the new enquiry notifications
ENQUIRY_TO_EMAIL=thirdspacecarehome@gmail.com
