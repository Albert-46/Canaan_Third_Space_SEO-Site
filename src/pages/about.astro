---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import { SITE_CONFIG } from '../config';

const title = "About";
const description = "Learn more about Canaan Third Space, where medical services and senior residential living come together in a calm, dignified environment.";
---

<BaseLayout title={title} description={description}>
  {/* Hero Section */}
  <section class="hero-minimal reveal">
    <div class="container text-block-narrow">
      <span class="eyebrow">{SITE_CONFIG.organization.name}</span>
      <h1>About Canaan Third Space</h1>
      <p>{description}</p>
    </div>
  </section>

  {/* Our Story */}
  <section class="section section-compact reveal">
    <div class="container text-block-narrow">
      <h2>Our story</h2>
      <p>Canaan Third Space was founded on the belief that aging and medical care should be handled with utmost dignity and respect. We recognized a growing need for an environment where seniors could receive continuous medical attention without losing the comfort and warmth of a residential home.</p>
      
      <p>By bringing together comprehensive medical services and supportive senior living, we ensure our residents are well-cared for at every stage. Our dedicated facility in Manimala is designed to be a calm, welcoming space that feels like home, while providing the safety and reassurance of professional healthcare.</p>
      
      <p>We prioritize clear communication with families, maintaining transparency about care plans, and honoring the individual preferences of every person we support.</p>
      
      <div style="margin-top: var(--space-8);">
        <ImagePlaceholder aspectRatio="21:9" label="CANAAN THIRD SPACE\nOUR ENVIRONMENT" />
      </div>
    </div>
  </section>

  {/* What Makes Us Different */}
  <section class="section section-compact section-bg-dim reveal">
    <div class="container text-block-narrow">
      <h2>What makes us different</h2>
      <ul style="margin-top: var(--space-6); display: flex; flex-direction: column; gap: var(--space-4);">
        <li style="display: flex; gap: var(--space-4); align-items: flex-start;">
          <span style="color: var(--color-secondary); font-size: 1.5rem; line-height: 1;">&bull;</span>
          <span style="font-size: var(--text-lg); color: var(--color-text);"><strong>Calm Environment:</strong> A thoughtfully designed space that promotes peace of mind and well-being.</span>
        </li>
        <li style="display: flex; gap: var(--space-4); align-items: flex-start;">
          <span style="color: var(--color-secondary); font-size: 1.5rem; line-height: 1;">&bull;</span>
          <span style="font-size: var(--text-lg); color: var(--color-text);"><strong>Coordinated Care:</strong> Seamless integration between daily living support and specialized medical attention.</span>
        </li>
        <li style="display: flex; gap: var(--space-4); align-items: flex-start;">
          <span style="color: var(--color-secondary); font-size: 1.5rem; line-height: 1;">&bull;</span>
          <span style="font-size: var(--text-lg); color: var(--color-text);"><strong>Transparent Communication:</strong> Keeping families informed and involved in every step of the care journey.</span>
        </li>
        <li style="display: flex; gap: var(--space-4); align-items: flex-start;">
          <span style="color: var(--color-secondary); font-size: 1.5rem; line-height: 1;">&bull;</span>
          <span style="font-size: var(--text-lg); color: var(--color-text);"><strong>Individualized Support:</strong> Personalized care plans that respect each resident's unique needs and dignity.</span>
        </li>
      </ul>
    </div>
  </section>

  {/* CTA Strip */}
  <section class="section section-compact reveal">
    <div class="container text-block-narrow text-center">
      <h2 style="margin-bottom: var(--space-6);">Take the next step</h2>
      <div style="display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap;">
        <a href="/contact" class="btn btn-primary">Speak with our team</a>
        <a href="/services" class="btn btn-secondary">Explore our services</a>
      </div>
    </div>
  </section>
</BaseLayout>
