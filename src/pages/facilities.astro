---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import { SITE_CONFIG } from '../config';
---

<BaseLayout title="Our Facilities" description={`View the modern medical and residential facilities at ${SITE_CONFIG.organization.name}.`}>
  <div class="page-header section-bg-dim" style="padding: var(--spacing-2xl) 0 var(--spacing-xl);">
    <div class="container text-center reveal">
      <h1>Our Facilities</h1>
      <p class="editorial-text" style="margin-top: var(--spacing-md);">
        Designed for safety, hygiene, and comfort. Take a look at the spaces where we provide care and support.
      </p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="grid-12" style="row-gap: var(--spacing-xl);">
        
        <!-- Feature 1 -->
        <div style="grid-column: span 6; display: flex; flex-direction: column; justify-content: center;" class="reveal">
          <div style="padding-right: var(--spacing-md);">
            <h2 style="font-size: var(--text-2xl);">Medical Centre</h2>
          <p style="margin-bottom: var(--spacing-sm);">Our clinical spaces are maintained to rigorous hygienic standards. Consultation rooms are private and acoustically separated to ensure patient confidentiality. The in-house laboratory ensures same-day diagnostic turnaround for most routine investigations.</p>
          <ul style="display: flex; flex-direction: column; gap: 8px; font-size: var(--text-sm); margin-top: var(--spacing-sm);">
            <li>&bull; Private OPD consultation rooms</li>
            <li>&bull; In-house diagnostic laboratory</li>
            <li>&bull; Clean, well-lit waiting areas</li>
            <li>&bull; Accessible layout for wheelchair users and elderly patients</li>
          </ul>
          </div>
        </div>
        <div style="grid-column: span 6;" class="reveal">
          <img src="/images/hospital/reception.svg" alt="Medical Reception" style="width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: var(--radius-sm);" />
        </div>

        <!-- Feature 2 -->
        <div style="grid-column: span 6;" class="reveal">
          <img src="/images/old-age-home/bedroom.svg" alt="Resident Bedroom" style="width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: var(--radius-sm);" />
        </div>
        <div style="grid-column: span 6; display: flex; flex-direction: column; justify-content: center;" class="reveal">
          <div style="padding-left: var(--spacing-md);">
            <h2 style="font-size: var(--text-2xl);">Residential Rooms</h2>
          <p style="margin-bottom: var(--spacing-sm);">Senior care rooms are designed for comfort, accessibility, and safety. Each room is furnished and maintained by our housekeeping team.</p>
          <ul style="display: flex; flex-direction: column; gap: 8px; font-size: var(--text-sm); margin-top: var(--spacing-sm);">
            <li>&bull; Anti-slip flooring and grab rails in bathrooms</li>
            <li>&bull; Emergency call bell accessible from the bed</li>
            <li>&bull; Ample natural light and ventilation</li>
            <li>&bull; Space for personal items and family photographs</li>
          </ul>
          </div>
        </div>

        <!-- Feature 3 -->
        <div style="grid-column: span 6; display: flex; flex-direction: column; justify-content: center;" class="reveal">
          <div style="padding-right: var(--spacing-md);">
            <h2 style="font-size: var(--text-2xl);">Common Areas &amp; Dining</h2>
          <p style="margin-bottom: var(--spacing-sm);">Social interaction is vital to resident well-being. Our common areas are designed to encourage conversation, light activities, and a sense of community.</p>
          <ul style="display: flex; flex-direction: column; gap: 8px; font-size: var(--text-sm); margin-top: var(--spacing-sm);">
            <li>&bull; Spacious common lounge for activities and socialising</li>
            <li>&bull; Communal dining with nutritious daily meals</li>
            <li>&bull; Seating area available for residents and family visits</li>
            <li>&bull; Designated family visit area</li>
          </ul>
          </div>
        </div>
        <div style="grid-column: span 6;" class="reveal">
          <img src="/images/old-age-home/dining-area.svg" alt="Dining Area" style="width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: var(--radius-sm);" />
        </div>

      </div>
    </div>
  </section>

  <CTABanner
    title="See for yourself."
    subtitle="The best way to understand our environment is to visit in person. We welcome families to tour the facility at a convenient time."
    primaryText="Call to Book a Tour"
    primaryLink={SITE_CONFIG.contact.phoneHref}
    secondaryText="Send an Enquiry"
    secondaryLink="/contact#enquiry"
  />
</BaseLayout>
