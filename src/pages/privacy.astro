---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../config';

const title = "Privacy Policy";
const description = "Privacy policy for Canaan Third Space Senior Care Home.";
const lastUpdated = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={title} description={description}>
  {/* Hero Section */}
  <section class="hero-minimal reveal">
    <div class="container text-block-narrow">
      <span class="eyebrow">Legal</span>
      <h1>Privacy Policy</h1>
      <p>Last updated: {lastUpdated}</p>
    </div>
  </section>

  {/* Policy Content */}
  <section class="section section-compact reveal">
    <div class="container text-block-narrow" style="display: flex; flex-direction: column; gap: var(--space-6);">
      
      <div>
        <h2 style="font-size: var(--text-2xl); margin-bottom: var(--space-4);">1. Information We Collect</h2>
        <p>We collect information you provide directly to us when you fill out an enquiry form or contact us via email, phone, or WhatsApp. This may include your name, phone number, email address, and any specific details you share regarding care needs.</p>
      </div>

      <div>
        <h2 style="font-size: var(--text-2xl); margin-bottom: var(--space-4);">2. How We Use Your Information</h2>
        <p>We use the information collected solely to respond to your enquiries, coordinate visits to our facility, and communicate with you about our medical services and senior care options. We do not use your information for unsolicited marketing.</p>
      </div>

      <div>
        <h2 style="font-size: var(--text-2xl); margin-bottom: var(--space-4);">3. Data Protection</h2>
        <p>We are committed to protecting your privacy. We do not sell, rent, or trade your personal data to third parties. Access to your information is limited to authorized personnel who need it to assist you and manage your care requirements securely.</p>
      </div>

      <div>
        <h2 style="font-size: var(--text-2xl); margin-bottom: var(--space-4);">4. Contact Us</h2>
        <p>If you have any questions or concerns about this Privacy Policy, please contact us at:</p>
        <p>
          <a href={`mailto:${SITE_CONFIG.contact.email}`} style="color: var(--color-primary); font-weight: 500;">{SITE_CONFIG.contact.email}</a>
        </p>
      </div>

    </div>
  </section>
</BaseLayout>
