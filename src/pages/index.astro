---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import { SITE_CONFIG } from '../config';

const title = "Canaan Third Space Senior Care Home";
const description = "Canaan Third Space Senior Care Home brings together medical services and supportive senior residential living in a calm, professionally managed environment.";
---

<BaseLayout title={title} description={description}>

  {/* ── Hero ───────────────────────────────────────────────── */}
  <section class="hero-section reveal">
    <div class="container hero-layout">

      <div class="hero-text">
        <span class="eyebrow">
          {SITE_CONFIG.organization.city}, {SITE_CONFIG.organization.district}, {SITE_CONFIG.organization.state}
        </span>
        <h1>Compassionate care.<br />Dignified living.</h1>
        <p>{description}</p>
        <div class="hero-actions">
          <a href="/contact#enquiry" class="btn btn-primary">Book a Facility Visit</a>
          <a href={SITE_CONFIG.contact.phoneHref} class="btn btn-secondary">Call Now</a>
          {SITE_CONFIG.features.enableWhatsAppAction && (
            <a href={SITE_CONFIG.contact.whatsappHref} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">WhatsApp</a>
          )}
        </div>
      </div>

      <div class="hero-image">
        <ImagePlaceholder aspectRatio="3:2" label={"CANAAN THIRD SPACE\nFACILITY EXTERIOR"} />
      </div>

    </div>
  </section>

  {/* ── Integrated Care ─────────────────────────────────────── */}
  <section class="section editorial-section reveal">
    <div class="container editorial-layout">

      <div class="editorial-text">
        <h2>Integrated care,<br class="desktop-br" /> under one roof</h2>
        <p>We provide comprehensive medical services alongside a supportive senior residential living facility, ensuring all health and lifestyle needs are met seamlessly in a single coordinated environment.</p>
        <div class="editorial-links">
          <a href="/services" class="thin-rule link-primary">View Medical Services &rarr;</a>
          <a href="/about" class="thin-rule link-primary">Explore Senior Care &rarr;</a>
        </div>
      </div>

      <div class="editorial-image">
        <ImagePlaceholder aspectRatio="3:2" label={"CANAAN THIRD SPACE\nRESIDENTIAL ENVIRONMENT"} />
      </div>

    </div>
  </section>

  {/* ── Why Families Choose Us ──────────────────────────────── */}
  <section class="section section-bg-dim why-section reveal">
    <div class="container why-layout">

      <div class="why-heading">
        <h2>Why families choose<br />Canaan Third Space</h2>
        <p class="why-intro">A calm, professionally managed environment where medical and residential care work together.</p>
      </div>

      <ul class="why-list">
        <li class="why-item">
          <span class="why-bullet" aria-hidden="true">&bull;</span>
          <span>Calm, professionally managed environment</span>
        </li>
        <li class="why-item">
          <span class="why-bullet" aria-hidden="true">&bull;</span>
          <span>Medical and residential care in one coordinated setting</span>
        </li>
        <li class="why-item">
          <span class="why-bullet" aria-hidden="true">&bull;</span>
          <span>Clear communication with families before and after admission</span>
        </li>
        <li class="why-item">
          <span class="why-bullet" aria-hidden="true">&bull;</span>
          <span>Respect for dignity, safety, and individual preferences</span>
        </li>
      </ul>

    </div>
  </section>

  {/* ── Closing Visual ──────────────────────────────────────── */}
  <section class="section section-compact visual-closing reveal">
    <div class="container">
      <ImagePlaceholder aspectRatio="21:9" label={"CANAAN THIRD SPACE\nCOMMON AREA"} />
    </div>
  </section>

  {/* ── Contact Strip ───────────────────────────────────────── */}
  <section class="section section-compact contact-section reveal">
    <div class="container contact-split">

      <div class="contact-split-info">
        <h3>Speak with our team</h3>
        <p class="contact-address-line">
          {SITE_CONFIG.contact.addressLine2}, {SITE_CONFIG.contact.addressLine1}, {SITE_CONFIG.contact.city}
        </p>
      </div>

      <div class="contact-split-actions">
        <a href={SITE_CONFIG.contact.phoneHref} class="thin-rule link-primary">
          Call {SITE_CONFIG.contact.phoneDisplay}
        </a>
        {SITE_CONFIG.features.enableWhatsAppAction && (
          <a href={SITE_CONFIG.contact.whatsappHref} class="thin-rule link-primary" target="_blank" rel="noopener noreferrer">WhatsApp</a>
        )}
        <a href={SITE_CONFIG.contact.mapUrl} class="thin-rule link-primary" target="_blank" rel="noopener noreferrer">Get Directions</a>
        <a href="/contact" class="btn btn-primary">Contact Us</a>
      </div>

    </div>
  </section>

  {/* ── Emergency Notice ────────────────────────────────────── */}
  {SITE_CONFIG.features.enableEmergencyNotice && (
    <section class="section section-compact emergency-wrapper">
      <div class="container text-block-narrow reveal">
        <div class="emergency-notice" style="margin: 0;">
          <p><strong>Notice:</strong> {SITE_CONFIG.emergency.disclaimer}</p>
        </div>
      </div>
    </section>
  )}

</BaseLayout>

<style>
  /* ── Design tokens ────────────────────────────────────────── */
  /* Shared link colour helper */
  .link-primary {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  /* ── Hero ───────────────────────────────────────────────── */
  .hero-section {
    background-color: var(--color-surface-2);
    padding-block: var(--space-10) var(--space-8);
  }

  .hero-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .hero-text {
    text-align: center;
  }
  .hero-text h1 {
    margin-bottom: var(--space-4);
  }
  .hero-text p {
    max-width: 600px;
    margin-inline: auto;
    margin-bottom: var(--space-6);
    font-size: clamp(1rem, 1.5vw + 0.5rem, 1.25rem);
  }
  .hero-actions {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: var(--space-2);
  }

  .hero-image {
    width: 100%;
  }

  /* Desktop hero: two-column, text left / image right */
  @media (min-width: 1024px) {
    .hero-section {
      padding-block: var(--space-20);
    }
    .hero-layout {
      flex-direction: row;
      align-items: center;
      gap: var(--space-16);
    }
    .hero-text {
      flex: 0 0 44%;
      text-align: left;
    }
    .hero-text p {
      margin-inline: 0;
    }
    .hero-actions {
      justify-content: flex-start;
    }
    .hero-image {
      flex: 1;
    }
  }

  /* ── Editorial (text + image) sections ─────────────────── */
  .editorial-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .editorial-text h2 {
    margin-bottom: var(--space-4);
  }
  .editorial-text p {
    max-width: 52ch;
    margin-bottom: var(--space-6);
  }
  .editorial-links {
    display: flex;
    gap: var(--space-6);
    flex-wrap: wrap;
    align-items: center;
  }

  .editorial-image {
    width: 100%;
  }

  /* Desktop: side-by-side */
  @media (min-width: 1024px) {
    .editorial-section {
      padding-block: var(--space-20);
    }
    .editorial-layout {
      flex-direction: row;
      align-items: center;
      gap: var(--space-16);
    }
    .editorial-text {
      flex: 0 0 42%;
    }
    .editorial-image {
      flex: 1;
    }
    /* Remove mobile BR on desktop — natural line breaks handle it */
    .desktop-br {
      display: none;
    }
  }

  /* ── Why Section ────────────────────────────────────────── */
  .why-section {
    padding-block: var(--space-12);
  }

  .why-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .why-heading h2 {
    margin-bottom: var(--space-4);
  }
  .why-intro {
    max-width: 48ch;
    margin: 0;
    font-size: var(--text-base);
  }

  .why-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .why-item {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    font-size: var(--text-lg);
    color: var(--color-text);
  }

  .why-bullet {
    color: var(--color-secondary);
    font-size: 1.4rem;
    line-height: 1.3;
    flex-shrink: 0;
  }

  /* Desktop: editorial two-column */
  @media (min-width: 1024px) {
    .why-section {
      padding-block: var(--space-20);
    }
    .why-layout {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-20);
    }
    .why-heading {
      flex: 0 0 36%;
      /* Keep heading pinned while list scrolls naturally */
      position: sticky;
      top: var(--space-12);
    }
    .why-intro {
      max-width: 100%;
    }
    .why-list {
      flex: 1;
      gap: var(--space-6);
      padding-top: var(--space-2);
    }
    .why-item {
      font-size: var(--text-xl);
      padding-bottom: var(--space-4);
      border-bottom: 1px solid var(--color-surface-3);
    }
    .why-item:last-child {
      border-bottom: none;
    }
  }

  /* ── Closing visual — full container width on desktop ──── */
  .visual-closing {
    padding-block: 0 var(--space-8);
  }
  @media (min-width: 1024px) {
    .visual-closing {
      padding-block: 0 var(--space-16);
    }
  }

  /* ── Contact Strip ──────────────────────────────────────── */
  .contact-split {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    background-color: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: var(--space-8);
  }

  .contact-split-info h3 {
    margin-bottom: var(--space-2);
  }
  .contact-address-line {
    font-size: var(--text-sm);
    margin: 0;
    opacity: 0.7;
  }

  .contact-split-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  /* Desktop: side-by-side strip */
  @media (min-width: 1024px) {
    .contact-split {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: var(--space-10) var(--space-12);
    }
    .contact-split-info {
      flex: 0 0 auto;
    }
    .contact-split-actions {
      flex-wrap: nowrap;
      justify-content: flex-end;
    }
  }
</style>
