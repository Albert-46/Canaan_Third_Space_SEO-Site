---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import { SITE_CONFIG } from '../config';

const title = "Canaan Third Space Senior Care Home";
const description = "Canaan Third Space Senior Care Home brings together medical services and supportive senior residential living in a calm, professionally managed environment.";
---

<BaseLayout title={title} description={description}>
  {/* Hero Section */}
  <section class="hero-minimal reveal">
    <div class="container text-block-narrow">
      <span class="eyebrow">{SITE_CONFIG.organization.city}, {SITE_CONFIG.organization.district}, {SITE_CONFIG.organization.state}</span>
      <h1>Compassionate care. Dignified living.</h1>
      <p>{description}</p>
      
      <div style="display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap; margin-top: var(--space-6); margin-bottom: var(--space-12);">
        <a href="/contact#enquiry" class="btn btn-primary">Book a Facility Visit</a>
        <a href={SITE_CONFIG.contact.phoneHref} class="btn btn-secondary">Call Now</a>
        {SITE_CONFIG.features.enableWhatsAppAction && (
          <a href={SITE_CONFIG.contact.whatsappHref} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">WhatsApp</a>
        )}
      </div>
      
      <ImagePlaceholder aspectRatio="16:9" label="CANAAN THIRD SPACE\nFACILITY EXTERIOR" />
    </div>
  </section>

  {/* What We Offer */}
  <section class="section section-compact reveal">
    <div class="container text-block-narrow text-center">
      <h2>Integrated care, under one roof</h2>
      <p>We provide comprehensive medical services alongside a supportive senior residential living facility, ensuring all your health and lifestyle needs are met seamlessly.</p>
      
      <div style="display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap; margin-top: var(--space-6);">
        <a href="/services" class="thin-rule" style="color: var(--color-primary); border-color: var(--color-primary);">View Medical Services &rarr;</a>
        <a href="/about" class="thin-rule" style="color: var(--color-primary); border-color: var(--color-primary);">Explore Senior Care &rarr;</a>
      </div>
    </div>
  </section>

  {/* Secondary Editorial Image */}
  <section class="section section-compact pt-0 reveal">
    <div class="container text-block-narrow">
      <ImagePlaceholder aspectRatio="3:2" label="CANAAN THIRD SPACE\nRESIDENTIAL ENVIRONMENT" />
    </div>
  </section>

  {/* Why Families Choose Us */}
  <section class="section section-compact section-bg-dim reveal">
    <div class="container text-block-narrow">
      <h2 class="text-center">Why families choose Canaan Third Space</h2>
      <ul style="margin-top: var(--space-8); display: flex; flex-direction: column; gap: var(--space-4);">
        <li style="display: flex; gap: var(--space-4); align-items: flex-start;">
          <span style="color: var(--color-secondary); font-size: 1.5rem; line-height: 1;">&bull;</span>
          <span style="font-size: var(--text-lg); color: var(--color-text);">Calm, professionally managed environment</span>
        </li>
        <li style="display: flex; gap: var(--space-4); align-items: flex-start;">
          <span style="color: var(--color-secondary); font-size: 1.5rem; line-height: 1;">&bull;</span>
          <span style="font-size: var(--text-lg); color: var(--color-text);">Medical and residential care in one coordinated setting</span>
        </li>
        <li style="display: flex; gap: var(--space-4); align-items: flex-start;">
          <span style="color: var(--color-secondary); font-size: 1.5rem; line-height: 1;">&bull;</span>
          <span style="font-size: var(--text-lg); color: var(--color-text);">Clear communication with families before and after admission</span>
        </li>
        <li style="display: flex; gap: var(--space-4); align-items: flex-start;">
          <span style="color: var(--color-secondary); font-size: 1.5rem; line-height: 1;">&bull;</span>
          <span style="font-size: var(--text-lg); color: var(--color-text);">Respect for dignity, safety, and individual preferences</span>
        </li>
      </ul>
    </div>
  </section>

  {/* Closing Visual Moment */}
  <section class="section section-compact reveal">
    <div class="container text-block-narrow">
      <ImagePlaceholder aspectRatio="21:9" label="CANAAN THIRD SPACE\nCOMMON AREA" />
    </div>
  </section>

  {/* Contact Strip */}
  <section class="section section-compact reveal">
    <div class="container text-block-narrow">
      <div class="contact-strip">
        <div>
          <h3 style="margin-bottom: var(--space-2); font-size: var(--text-2xl);">Speak with our team</h3>
          <p style="margin: 0; font-size: var(--text-sm); max-width: 300px;">
            {SITE_CONFIG.contact.addressLine2}, {SITE_CONFIG.contact.addressLine1}, {SITE_CONFIG.contact.city}
          </p>
        </div>
        <div style="display: flex; gap: var(--space-4); align-items: center; flex-wrap: wrap;">
          <a href={SITE_CONFIG.contact.phoneHref} class="thin-rule" style="color: var(--color-primary); border-color: var(--color-primary);">Call {SITE_CONFIG.contact.phoneDisplay}</a>
          {SITE_CONFIG.features.enableWhatsAppAction && (
            <a href={SITE_CONFIG.contact.whatsappHref} class="thin-rule" style="color: var(--color-primary); border-color: var(--color-primary);" target="_blank" rel="noopener noreferrer">WhatsApp</a>
          )}
          <a href={SITE_CONFIG.contact.mapUrl} class="thin-rule" style="color: var(--color-primary); border-color: var(--color-primary);" target="_blank" rel="noopener noreferrer">Get Directions</a>
          <a href="/contact" class="btn btn-primary">Contact Us</a>
        </div>
      </div>
    </div>
  </section>

  {/* Emergency Notice */}
  {SITE_CONFIG.features.enableEmergencyNotice && (
    <section class="section section-compact" style="padding-top: 0; padding-bottom: var(--space-8);">
      <div class="container text-block-narrow reveal">
        <div class="emergency-notice" style="margin: 0;">
          <p><strong>Notice:</strong> {SITE_CONFIG.emergency.disclaimer}</p>
        </div>
      </div>
    </section>
  )}
</BaseLayout>
