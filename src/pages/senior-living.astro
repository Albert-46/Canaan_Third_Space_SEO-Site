---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import { SITE_CONFIG } from '../config';
import { seniorCareServices } from '../content/services';

const activeServices = seniorCareServices.filter(s => s.enabled);
---

<BaseLayout
  title="Senior Care Home — Residential Care in Manimala, Kottayam"
  description={`Dignified, supportive residential senior care at ${SITE_CONFIG.organization.name}, Manimala, Kottayam. Long-term and assisted living, with on-site medical services. Short-term respite stays by prior arrangement.`}
>
  <div class="page-header section-bg-dark" style="padding: var(--spacing-2xl) 0 var(--spacing-xl);">
    <div class="container text-center reveal">
      <span class="eyebrow" style="color: var(--sand);">Manimala, Kottayam, Kerala</span>
      <h1>Senior Care Home</h1>
      <p style="font-size: var(--text-lg); opacity: 0.9; max-width: 600px; margin: 0 auto; margin-top: var(--spacing-sm);">
        A warm, professionally managed residential community where seniors live with dignity, daily support, and immediate access to on-site medical care.
      </p>
    </div>
  </div>

  <!-- Living with Dignity -->
  <section class="section">
    <div class="container grid-12">
      <div style="grid-column: span 5;" class="reveal">
        <span class="eyebrow">Our Approach</span>
        <h2 style="font-size: var(--text-2xl); margin-bottom: var(--spacing-sm);">A home — not a ward.</h2>
        <p style="line-height: 1.7; margin-bottom: var(--spacing-sm);">
          Our senior care home is designed to feel like a residence. Residents have their own furnished space, a structured daily routine, nutritious meals, and the company of a supportive community — while remaining connected to their families.
        </p>
        <p style="line-height: 1.7; margin-bottom: var(--spacing-sm);">
          Because we are fully integrated with our medical centre, residents benefit from on-site medical supervision without the disruption of external transfers. Our clinical team conducts regular health reviews, and any change in a resident's condition is addressed promptly by the nursing team.
        </p>
        <p style="line-height: 1.7;">
          We provide <strong>long-term residential care</strong> and <strong>assisted living support</strong>, tailored to the individual's level of independence and medical requirements. <strong>Short-term respite stays</strong> (by prior arrangement) are available subject to room availability — contact us to enquire.
        </p>
      </div>
      <div style="grid-column: 7 / span 6;" class="reveal">
        <img src="/images/old-age-home/home-exterior.svg" alt="Exterior of Canaan Third Space Senior Care Home, Manimala" style="width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: var(--radius-sm);" />
      </div>
    </div>
  </section>

  <!-- Care Pillars -->
  <section class="section section-bg-dim">
    <div class="container text-center reveal mb-lg">
      <span class="eyebrow">What We Provide</span>
      <h2 style="font-size: var(--text-3xl);">Care &amp; Support</h2>
      <p style="margin-top: var(--spacing-sm); max-width: 600px; margin-inline: auto;">
        Every aspect of our residential model is designed around the resident — their comfort, routine, independence, and connection with family.
      </p>
    </div>
    <div class="container grid-12">
      {activeServices.map(service => (
        <div style="grid-column: span 4;" class="reveal">
          <div style="background: var(--white); padding: var(--spacing-md); border: 1px solid var(--soft-gray); border-radius: var(--radius-sm); height: 100%;">
            <h3 style="font-size: var(--text-xl); margin-bottom: var(--spacing-sm);">{service.name}</h3>
            <p style="font-size: var(--text-base); opacity: 0.9; line-height: 1.7;">{service.shortDescription}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- What to Expect -->
  <section class="section">
    <div class="container grid-12">
      <div style="grid-column: span 5;" class="reveal">
        <span class="eyebrow">Day to Day</span>
        <h2 style="font-size: var(--text-2xl); margin-bottom: var(--spacing-sm);">What daily life looks like</h2>
        <p style="line-height: 1.7; margin-bottom: var(--spacing-sm);">
          Residents follow a structured daily schedule that balances rest, personal care, meals, and activities. Care staff work alongside each resident to understand individual preferences — whether that is a morning walk, a quiet afternoon, or participation in group activities.
        </p>
        <ul class="feature-list">
          <li>Morning health checks by the nursing team</li>
          <li>Three nutritious meals and snacks daily</li>
          <li>Medication management and administration</li>
          <li>Light physical activities and gentle mobility exercises</li>
          <li>Social engagement and companionship</li>
          <li>Regular family communication and visit coordination</li>
          <li>On-call medical review when needed</li>
        </ul>
      </div>
      <div style="grid-column: 7 / span 6;" class="reveal">
        <img src="/images/old-age-home/bedroom.svg" alt="Comfortable resident bedroom at Canaan Third Space" style="width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: var(--radius-sm);" />
      </div>
    </div>
  </section>

  <!-- Admission Process -->
  <section class="section section-bg-dim" id="admission">
    <div class="container">
      <div class="text-center reveal" style="margin-bottom: var(--spacing-lg);">
        <span class="eyebrow">Getting Started</span>
        <h2 style="font-size: var(--text-3xl);">How admission works</h2>
        <p style="max-width: 600px; margin-inline: auto; margin-top: var(--spacing-sm);">
          We make the admission process as clear and straightforward as possible. Families are welcome to ask questions at every step.
        </p>
      </div>

      <div class="grid-12">
        <div class="admit-step reveal" style="grid-column: span 3;">
          <span class="admit-number">01</span>
          <h3>Initial enquiry</h3>
          <p>Call or send an online enquiry. Tell us about your loved one's needs, level of independence, and any existing medical conditions. Our admissions team will help you understand whether our facility is the right fit.</p>
          <a href={SITE_CONFIG.contact.phoneHref} class="thin-rule step-link">Call us &rarr;</a>
        </div>
        <div class="admit-step reveal" style="grid-column: span 3; transition-delay: 0.1s;">
          <span class="admit-number">02</span>
          <h3>Facility visit</h3>
          <p>We invite all families and prospective residents to visit in person. You will tour the residential rooms, common areas, and dining spaces, and meet our care team at a convenient time.</p>
          <a href="/contact#enquiry" class="thin-rule step-link">Arrange a visit &rarr;</a>
        </div>
        <div class="admit-step reveal" style="grid-column: span 3; transition-delay: 0.2s;">
          <span class="admit-number">03</span>
          <h3>Medical assessment</h3>
          <p>Our medical officer will review the prospective resident's health records and conduct a brief assessment to ensure we can meet their specific medical and personal care needs safely and effectively.</p>
        </div>
        <div class="admit-step reveal" style="grid-column: span 3; transition-delay: 0.3s;">
          <span class="admit-number">04</span>
          <h3>Admission &amp; settling in</h3>
          <p>On admission day, our team will guide the resident and family through the orientation process — room setup, introducing key staff, explaining the daily schedule, and confirming family communication arrangements.</p>
        </div>
      </div>

      <!-- What to bring -->
      <div class="reveal" style="margin-top: var(--spacing-xl); background: var(--white); border: 1px solid var(--soft-gray); border-radius: var(--radius-sm); padding: var(--spacing-md);">
        <h3 style="font-size: var(--text-xl); margin-bottom: var(--spacing-sm);">What families should bring on admission day</h3>
        <div class="grid-12" style="gap: var(--spacing-sm);">
          <div style="grid-column: span 6;">
            <ul class="bring-list">
              <li>Completed medical history and current prescription list</li>
              <li>Recent investigation reports (blood tests, scans)</li>
              <li>Government-issued photo ID (Aadhaar / passport)</li>
              <li>Health insurance documents (if applicable)</li>
            </ul>
          </div>
          <div style="grid-column: span 6;">
            <ul class="bring-list">
              <li>Comfortable, loose-fitting clothing (one week's worth)</li>
              <li>Personal toiletries and any preferred hygiene items</li>
              <li>Mobility aids currently in use (walking stick, hearing aids)</li>
              <li>Personal items — photographs, books, devotional items</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Questions to ask -->
      <div class="reveal" style="margin-top: var(--spacing-md); background: var(--soft-gray); border-radius: var(--radius-sm); padding: var(--spacing-md);">
        <h3 style="font-size: var(--text-base); font-weight: 600; margin-bottom: 12px;">Questions families often ask during a visit</h3>
        <ul class="question-list">
          <li>How are medical emergencies handled during the night?</li>
          <li>What is the ratio of care staff to residents?</li>
          <li>How are families notified if a resident's health changes?</li>
          <li>Can residents bring their own furniture or personal items?</li>
          <li>What visiting arrangements are in place for families?</li>
          <li>Can a resident try a short respite stay before committing to long-term admission?</li>
        </ul>
        <p style="font-size: var(--text-sm); margin-top: var(--spacing-sm); opacity: 0.75;">Bring your questions — our team is happy to discuss every concern openly and honestly during your visit.</p>
      </div>
    </div>
  </section>

  <CTABanner
    title="Arrange a facility visit."
    subtitle={`We welcome families to tour our senior care home in Manimala and meet the team. Visits by appointment, ${SITE_CONFIG.contact.openingHours}.`}
    primaryText="Call to Schedule"
    primaryLink={SITE_CONFIG.contact.phoneHref}
    secondaryText="Send an Enquiry"
    secondaryLink="/contact#enquiry"
  />
</BaseLayout>

<style>
  .feature-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: var(--spacing-md);
  }
  .feature-list li {
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(20, 28, 25, 0.08);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .admit-step {
    padding: var(--spacing-md);
    background: var(--white);
    border: 1px solid var(--soft-gray);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
  }
  .admit-number {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    color: var(--eucalyptus);
    opacity: 0.3;
    line-height: 1;
    margin-bottom: var(--spacing-sm);
  }
  .admit-step h3 {
    font-size: var(--text-base);
    font-weight: 600;
    margin-bottom: 8px;
  }
  .admit-step p {
    font-size: var(--text-sm);
    line-height: 1.7;
    flex: 1;
    margin-bottom: 12px;
  }
  .step-link {
    font-size: var(--text-sm);
    font-weight: 600;
    margin-top: auto;
  }
  .bring-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .bring-list li {
    font-size: var(--text-sm);
    line-height: 1.6;
    padding-left: 16px;
    position: relative;
  }
  .bring-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--eucalyptus);
    font-weight: 600;
  }
  .question-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .question-list li {
    font-size: var(--text-sm);
    line-height: 1.6;
    padding-left: 16px;
    position: relative;
  }
  .question-list li::before {
    content: '?';
    position: absolute;
    left: 0;
    color: var(--brass);
    font-weight: 600;
  }
  .mb-lg { margin-bottom: var(--spacing-lg); }

  @media (max-width: 768px) {
    .admit-step {
      grid-column: span 6 !important;
    }
  }
  @media (max-width: 500px) {
    .admit-step {
      grid-column: span 12 !important;
    }
    .bring-list {
      grid-column: span 12 !important;
    }
  }
</style>
