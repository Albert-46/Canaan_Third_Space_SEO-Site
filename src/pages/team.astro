---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import { SITE_CONFIG } from '../config';
---

<BaseLayout title="Our Care Team" description={`Meet the dedicated medical and care professionals at ${SITE_CONFIG.organization.name}.`}>
  <div class="page-header section-bg-dim" style="padding: var(--spacing-2xl) 0 var(--spacing-xl);">
    <div class="container text-center reveal">
      <h1>Our Care Team</h1>
      <p class="editorial-text" style="margin-top: var(--spacing-md);">
        Experienced, compassionate professionals dedicated to your health and well-being.
      </p>
    </div>
  </div>

  <section class="section">
    <div class="container grid-12">
      <div style="grid-column: 2 / span 10;" class="reveal">
        <h2 style="font-size: var(--text-2xl); margin-bottom: var(--spacing-md);">How our team supports residents and families</h2>
        <p style="font-size: var(--text-lg); line-height: 1.6; margin-bottom: var(--spacing-lg);">
          At {SITE_CONFIG.organization.name}, our care team brings together clinical expertise and daily caregiving support. Doctors, nurses, caregivers, and support staff work together to coordinate medical care, residential support, and family communication for every resident and patient. We combine clinical expertise with genuine empathy to ensure that every patient and resident receives personalized, dignified support. Our team members undergo rigorous training and adhere strictly to medical best practices while prioritizing the comfort and preferences of those in our care.
        </p>

        <h3 style="font-size: var(--text-xl); margin-bottom: var(--spacing-sm);">How we coordinate medical and residential support</h3>
        <p style="font-size: var(--text-base); line-height: 1.6; margin-bottom: var(--spacing-md);">
          Because our senior care home is fully integrated with our medical services, coordination is seamless. Our nursing staff and residential caregivers work directly alongside our medical officers to monitor health daily. This ensures that any change in a resident's condition is promptly addressed by our clinical team, without the need for stressful external transfers.
        </p>
        <p style="font-size: var(--text-base); line-height: 1.6; margin-bottom: var(--spacing-md);">
          We maintain transparent, regular communication with families. You will always be informed about your loved one's health status, care plan adjustments, and daily well-being.
        </p>
      </div>
    </div>
  </section>

  <CTABanner title="Speak with our team." subtitle="Contact us to schedule a consultation with our medical professionals or arrange a facility visit." />
</BaseLayout>
