---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../config';

const title = "Medical Services & Senior Care";
const description = "Comprehensive medical care and supportive senior residential living, integrated seamlessly at Canaan Third Space.";
---

<BaseLayout title={title} description={description}>
  {/* Hero Section — left-aligned, clear and structured */}
  <section class="hero-minimal hero-minimal--left reveal">
    <div class="container">
      <span class="eyebrow">Our Offerings</span>
      <h1>Medical Services &amp; Senior Care</h1>
      <p>{description}</p>
    </div>
  </section>

  {/* Medical Services */}
  <section class="section section-compact reveal">
    <div class="container text-block-narrow">
      <h2>Medical Services</h2>
      <p>Our facility is equipped to handle a wide range of medical needs, ensuring prompt and professional care for all patients and residents.</p>
      
      <ul style="margin-top: var(--space-4); display: flex; flex-direction: column; gap: var(--space-3);">
        <li style="display: flex; gap: var(--space-4); align-items: flex-start;">
          <span style="color: var(--color-primary); font-size: 1.5rem; line-height: 1;">&bull;</span>
          <span style="font-size: var(--text-base); color: var(--color-text);"><strong>OPD Consultations:</strong> Regular access to experienced doctors and specialists.</span>
        </li>
        <li style="display: flex; gap: var(--space-4); align-items: flex-start;">
          <span style="color: var(--color-primary); font-size: 1.5rem; line-height: 1;">&bull;</span>
          <span style="font-size: var(--text-base); color: var(--color-text);"><strong>Laboratory Services:</strong> Comprehensive diagnostic tests available on-site.</span>
        </li>
        <li style="display: flex; gap: var(--space-4); align-items: flex-start;">
          <span style="color: var(--color-primary); font-size: 1.5rem; line-height: 1;">&bull;</span>
          <span style="font-size: var(--text-base); color: var(--color-text);"><strong>Inpatient Care:</strong> Dedicated wards and private rooms with continuous medical monitoring.</span>
        </li>
        <li style="display: flex; gap: var(--space-4); align-items: flex-start;">
          <span style="color: var(--color-primary); font-size: 1.5rem; line-height: 1;">&bull;</span>
          <span style="font-size: var(--text-base); color: var(--color-text);"><strong>Emergency Support:</strong> Immediate assistance and stabilization for urgent health conditions.</span>
        </li>
      </ul>
    </div>
  </section>

  {/* Senior Care Home */}
  <section class="section section-compact section-bg-dim reveal">
    <div class="container text-block-narrow">
      <h2>Senior Care Home</h2>
      <p>We provide a supportive, dignified residential environment designed specifically for the well-being and comfort of older adults.</p>
      
      <ul style="margin-top: var(--space-4); display: flex; flex-direction: column; gap: var(--space-3);">
        <li style="display: flex; gap: var(--space-4); align-items: flex-start;">
          <span style="color: var(--color-primary); font-size: 1.5rem; line-height: 1;">&bull;</span>
          <span style="font-size: var(--text-base); color: var(--color-text);"><strong>Residential Accommodation:</strong> Clean, safe, and comfortable living spaces.</span>
        </li>
        <li style="display: flex; gap: var(--space-4); align-items: flex-start;">
          <span style="color: var(--color-primary); font-size: 1.5rem; line-height: 1;">&bull;</span>
          <span style="font-size: var(--text-base); color: var(--color-text);"><strong>Daily Support:</strong> Assistance with daily living activities, personal care, and mobility.</span>
        </li>
        <li style="display: flex; gap: var(--space-4); align-items: flex-start;">
          <span style="color: var(--color-primary); font-size: 1.5rem; line-height: 1;">&bull;</span>
          <span style="font-size: var(--text-base); color: var(--color-text);"><strong>Nutritious Meals:</strong> Dietary-planned meals to support overall health and specific conditions.</span>
        </li>
        <li style="display: flex; gap: var(--space-4); align-items: flex-start;">
          <span style="color: var(--color-primary); font-size: 1.5rem; line-height: 1;">&bull;</span>
          <span style="font-size: var(--text-base); color: var(--color-text);"><strong>Family Communication:</strong> Regular updates to keep loved ones informed and connected.</span>
        </li>
      </ul>
    </div>
  </section>

  {/* How It Works Together — editorial split */}
  {/*
      Mobile:  text → image (stacked)
      Desktop: text left ~42%, care room image right ~58%
      Image: environmental, not clinical. Shows room character.
  */}
  <section class="section section-compact reveal">
    <div class="container">
      <div class="care-split">

        <div class="care-text">
          <h2>How it works together</h2>
          <p>Because our medical facilities and senior living accommodations share the same campus, residents benefit from continuous health monitoring. Changes in health are addressed immediately by our on-site medical team, avoiding the stress of external hospital transfers for routine care.</p>
        </div>

        <div class="care-image">
          <img
            src="/images/third-space/care/care-room.png"
            alt="Care room at Third Space, equipped for resident comfort and support"
            class="editorial-img editorial-img--rounded"
            loading="lazy"
            decoding="async"
          />
        </div>

      </div>
    </div>
  </section>

  {/* CTA Strip */}
  <section class="section section-compact reveal">
    <div class="container text-block-narrow">
      <h2 style="margin-bottom: var(--space-6);">Have questions?</h2>
      <div style="display: flex; gap: var(--space-4); flex-wrap: wrap;">
        <a href="/contact#enquiry" class="btn btn-primary">Request a visit</a>
        <a href={SITE_CONFIG.contact.phoneHref} class="btn btn-secondary">Call us</a>
        {SITE_CONFIG.features.enableWhatsAppAction && (
          <a href={SITE_CONFIG.contact.whatsappHref} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">WhatsApp</a>
        )}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     CARE SPLIT — text left, room image right (desktop)
     Environmental image: shows room character, not clinical UI
  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
  .care-split {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* Mobile: 4:3 shows the room with spatial context.
     Centred position preserves the bed/room composition. */
  .care-image img {
    aspect-ratio: 4 / 3;
    width: 100%;
    object-position: center;
  }

  @media (min-width: 768px) {
    .care-split {
      flex-direction: row;
      align-items: stretch;
      gap: var(--space-12);
    }

    .care-text {
      flex: 0 0 42%;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .care-image {
      flex: 1;
    }

    /* Desktop: image fills full column — room reads as environment, not a card */
    .care-image img {
      aspect-ratio: unset;
      height: 100%;
      min-height: 360px;
      object-position: center;
    }
  }

  @media (min-width: 1024px) {
    .care-split {
      gap: var(--space-16);
    }

    .care-image img {
      min-height: 440px;
    }
  }
</style>
