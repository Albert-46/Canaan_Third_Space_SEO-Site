---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CTABanner from '../components/CTABanner.astro';
import { SITE_CONFIG } from '../config';
import { medicalServices } from '../content/services';

const activeServices = medicalServices.filter(s => s.enabled);
---

<BaseLayout title="Medical Services" description={`Explore outpatient, inpatient, and laboratory medical services at ${SITE_CONFIG.organization.name}.`}>
  <div class="page-header section-bg-dim" style="padding: var(--spacing-2xl) 0 var(--spacing-xl);">
    <div class="container text-center reveal">
      <h1>Medical Services</h1>
      <p class="editorial-text" style="margin-top: var(--spacing-md);">
        Comprehensive clinical care delivered by experienced professionals in a safe, hygienic, and modern environment.
      </p>
    </div>
  </div>

  <section class="section">
    <div class="container grid-12">
      <div style="grid-column: span 4;" class="reveal">
        <h2 style="font-size: var(--text-2xl); position: sticky; top: 120px;">Clinical Excellence</h2>
        <p style="margin-top: var(--spacing-sm);">Our medical centre is equipped to handle routine consultations, diagnostics, and inpatient care. We prioritise patient safety, accurate diagnosis, and clear communication with families.</p>
      </div>
      <div style="grid-column: 6 / span 7;">
        <div style="display: flex; flex-direction: column; gap: var(--spacing-lg);">
          {activeServices.map((service, index) => (
            <div id={service.id} class="reveal" style="scroll-margin-top: 120px; border-bottom: 1px solid var(--soft-gray); padding-bottom: var(--spacing-lg);">
              <div style="display: flex; align-items: center; gap: 15px; margin-bottom: var(--spacing-md);">
                <span style="font-family: var(--font-display); font-size: var(--text-2xl); color: var(--brass); opacity: 0.5;">{String(index + 1).padStart(2, '0')}</span>
                <h3 style="font-size: var(--text-xl); margin: 0;">{service.name}</h3>
              </div>
              <p style="font-size: var(--text-base); margin-bottom: var(--spacing-md);">{service.shortDescription}</p>
              
              {/* Demo conditional content rendering based on ID */}
              {service.id === 'opd' && (
                <div class="grid-12" style="gap: var(--spacing-sm); margin-top: var(--spacing-md);">
                  <div style="grid-column: span 6;">
                    <img src="/images/hospital/consultation-room.svg" alt="Consultation Room" style="width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: var(--radius-sm);" />
                  </div>
                  <div style="grid-column: span 6; display: flex; flex-direction: column; justify-content: center;">
                    <p style="margin-bottom: var(--spacing-sm); font-size: var(--text-sm); line-height: 1.6;">Our Outpatient Department is designed for prompt, professional medical attention. To reduce wait times, we recommend enquiring ahead of your visit.</p>
                    <ul style="display: flex; flex-direction: column; gap: 10px;">
                      <li>&bull; General medicine consultations</li>
                      <li>&bull; Geriatric care and age-related support</li>
                      <li>&bull; Chronic disease management programs</li>
                      <li>&bull; Preventative health checks</li>
                    </ul>
                  </div>
                </div>
              )}

              {service.id === 'lab' && (
                <div class="grid-12" style="gap: var(--spacing-sm); margin-top: var(--spacing-md);">
                  <div style="grid-column: span 6;">
                    <img src="/images/hospital/laboratory.svg" alt="Laboratory" style="width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: var(--radius-sm);" />
                  </div>
                  <div style="grid-column: span 6; display: flex; flex-direction: column; justify-content: center;">
                    <p style="margin-bottom: var(--spacing-sm); font-size: var(--text-sm); line-height: 1.6;">Our in-house laboratory provides rapid and accurate diagnostic support. Results are communicated directly to your treating doctor for seamless care.</p>
                    <ul style="display: flex; flex-direction: column; gap: 10px;">
                      <li>&bull; Comprehensive Haematology</li>
                      <li>&bull; Routine and specialized Biochemistry</li>
                      <li>&bull; Clinical Microbiology</li>
                      <li>&bull; Fast, accurate reporting</li>
                    </ul>
                  </div>
                </div>
              )}

              {service.id === 'inpatient' && (
                <div class="grid-12" style="gap: var(--spacing-sm); margin-top: var(--spacing-md);">
                  <div style="grid-column: span 12;">
                    <p style="font-size: var(--text-sm); line-height: 1.6; margin-bottom: var(--spacing-sm);">We provide dedicated inpatient admission for conditions requiring close medical observation and nursing care. Our inpatient wards are designed to offer a clean, calming environment while ensuring immediate access to medical interventions when necessary.</p>
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CTABanner title="Schedule a consultation." subtitle="Contact our reception to confirm availability and book an appointment with our medical professionals." primaryText="Enquire Availability" />
</BaseLayout>
