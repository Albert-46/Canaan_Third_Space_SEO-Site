---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE_CONFIG } from '../config';

const title = "Contact Us";
const description = "Get in touch with Canaan Third Space. We are here to answer your questions, schedule visits, and support your healthcare and senior living needs.";
---

<BaseLayout title={title} description={description}>
  {/* Hero Section */}
  <section class="hero-minimal reveal">
    <div class="container text-block-narrow">
      <span class="eyebrow">Get in Touch</span>
      <h1>Contact Us</h1>
      <p>We are here to answer your questions, schedule visits, and provide the support you and your family need.</p>
    </div>
  </section>

  {/* Contact Details & Form */}
  <section class="section section-compact reveal">
    <div class="container">
      <div class="grid-12" style="gap: var(--space-12);">
        <div style="grid-column: span 5; display: flex; flex-direction: column; gap: var(--space-8);">
          <div>
            <h2 style="font-size: var(--text-2xl); margin-bottom: var(--space-6);">Contact Details</h2>
            <ul style="display: flex; flex-direction: column; gap: var(--space-4);">
              <li>
                <span class="eyebrow" style="margin-bottom: var(--space-2);">Phone</span>
                <a href={SITE_CONFIG.contact.phoneHref} style="font-size: var(--text-lg); color: var(--color-primary); font-weight: 500;">{SITE_CONFIG.contact.phoneDisplay}</a>
              </li>
              {SITE_CONFIG.features.enableWhatsAppAction && (
                <li>
                  <span class="eyebrow" style="margin-bottom: var(--space-2);">WhatsApp</span>
                  <a href={SITE_CONFIG.contact.whatsappHref} style="font-size: var(--text-lg); color: var(--color-primary); font-weight: 500;" target="_blank" rel="noopener noreferrer">Message us on WhatsApp</a>
                </li>
              )}
              <li>
                <span class="eyebrow" style="margin-bottom: var(--space-2);">Email</span>
                <a href={`mailto:${SITE_CONFIG.contact.email}`} style="font-size: var(--text-lg); color: var(--color-primary); font-weight: 500;">{SITE_CONFIG.contact.email}</a>
              </li>
              <li>
                <span class="eyebrow" style="margin-bottom: var(--space-2);">Address</span>
                <address style="font-style: normal; font-size: var(--text-lg); color: var(--color-text); line-height: 1.6;">
                  {SITE_CONFIG.contact.addressLine2}<br />
                  {SITE_CONFIG.contact.addressLine1}<br />
                  {SITE_CONFIG.contact.city}, {SITE_CONFIG.contact.district}<br />
                  {SITE_CONFIG.contact.state} - {SITE_CONFIG.contact.postalCode}
                </address>
                <a href={SITE_CONFIG.contact.mapUrl} class="thin-rule" style="margin-top: var(--space-4); color: var(--color-primary); border-color: var(--color-primary);" target="_blank" rel="noopener noreferrer">Get Directions &rarr;</a>
              </li>
            </ul>
          </div>
        </div>

        <div style="grid-column: span 7;">
          <div class="card" id="enquiry">
            <h2 style="font-size: var(--text-2xl); margin-bottom: var(--space-6);">Send an Enquiry</h2>
            <ContactForm />
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Emergency Notice */}
  {SITE_CONFIG.features.enableEmergencyNotice && (
    <section class="section section-compact reveal">
      <div class="container text-block-narrow">
        <div class="emergency-notice text-center">
          <p><strong>Notice:</strong> {SITE_CONFIG.emergency.disclaimer}</p>
        </div>
      </div>
    </section>
  )}
</BaseLayout>
