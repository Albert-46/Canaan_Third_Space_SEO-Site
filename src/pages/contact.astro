---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE_CONFIG } from '../config';

const title = "Contact Us";
const description = "Get in touch with Canaan Third Space. We are here to answer your questions, schedule visits, and support your healthcare and senior living needs.";
---

<BaseLayout title={title} description={description}>
  {/* Hero Section */}
  <section class="hero-minimal reveal">
    <div class="container text-block-narrow">
      <span class="eyebrow">Get in Touch</span>
      <h1>Contact Us</h1>
      <p>We are here to answer your questions, schedule visits, and provide the support you and your family need.</p>
    </div>
  </section>

  {/* Contact Details & Form */}
  <section class="section section-compact reveal">
    <div class="container">
      <div class="contact-layout">
        
        {/* Contact details column */}
        <div class="contact-details-col">
          <h2>Contact Details</h2>
          <ul class="contact-detail-list">
            <li>
              <span class="eyebrow">Phone</span>
              <a href={SITE_CONFIG.contact.phoneHref} class="contact-detail-value">{SITE_CONFIG.contact.phoneDisplay}</a>
            </li>
            {SITE_CONFIG.features.enableWhatsAppAction && (
              <li>
                <span class="eyebrow">WhatsApp</span>
                <a href={SITE_CONFIG.contact.whatsappHref} class="contact-detail-value" target="_blank" rel="noopener noreferrer">Message us on WhatsApp</a>
              </li>
            )}
            <li>
              <span class="eyebrow">Email</span>
              <a href={`mailto:${SITE_CONFIG.contact.email}`} class="contact-detail-value">{SITE_CONFIG.contact.email}</a>
            </li>
            <li>
              <span class="eyebrow">Address</span>
              <address class="contact-address">
                {SITE_CONFIG.contact.addressLine2}<br />
                {SITE_CONFIG.contact.addressLine1}<br />
                {SITE_CONFIG.contact.city}, {SITE_CONFIG.contact.district}<br />
                {SITE_CONFIG.contact.state} – {SITE_CONFIG.contact.postalCode}
              </address>
              <a href={SITE_CONFIG.contact.mapUrl} class="thin-rule contact-map-link" target="_blank" rel="noopener noreferrer">Get Directions &rarr;</a>
            </li>
          </ul>
        </div>

        {/* Enquiry form column */}
        <div class="contact-form-col" id="enquiry">
          <div class="card">
            <h2>Send an Enquiry</h2>
            <ContactForm />
          </div>
        </div>

      </div>
    </div>
  </section>

  {/* Emergency Notice */}
  {SITE_CONFIG.features.enableEmergencyNotice && (
    <section class="section section-compact reveal">
      <div class="container text-block-narrow">
        <div class="emergency-notice">
          <p><strong>Notice:</strong> {SITE_CONFIG.emergency.disclaimer}</p>
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* Mobile-first: stacked layout */
  .contact-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  /* Desktop: side-by-side */
  @media (min-width: 768px) {
    .contact-layout {
      display: grid;
      grid-template-columns: 5fr 7fr;
      gap: var(--space-12);
      align-items: start;
    }
  }

  .contact-details-col h2,
  .contact-form-col h2 {
    font-size: clamp(1.25rem, 2vw + 0.5rem, 2rem);
    margin-bottom: var(--space-6);
  }

  .contact-detail-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .contact-detail-list .eyebrow {
    margin-bottom: var(--space-1);
  }

  .contact-detail-value {
    display: block;
    font-size: var(--text-lg);
    color: var(--color-primary);
    font-weight: 500;
    /* Comfortable tap target */
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  .contact-address {
    font-style: normal;
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: 1.7;
    margin-bottom: var(--space-3);
  }

  .contact-map-link {
    display: inline-block;
    color: var(--color-primary);
    border-color: var(--color-primary);
    min-height: 44px;
    line-height: 44px;
  }
</style>
