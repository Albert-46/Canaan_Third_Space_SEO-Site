---
export interface Props {
  aspectRatio?: '16:9' | '3:2' | '4:3' | '1:1' | '21:9' | 'auto';
  label?: string;
  minHeight?: string;
}

const { 
  aspectRatio = '3:2',
  label = 'CANAAN THIRD SPACE\nFACILITY PHOTOGRAPHY',
  minHeight
} = Astro.props;

// Convert aspect ratio string to CSS value
const ratioMap: Record<string, string> = {
  '16:9': '16 / 9',
  '3:2': '3 / 2',
  '4:3': '4 / 3',
  '1:1': '1 / 1',
  '21:9': '21 / 9',
  'auto': 'auto'
};

const aspectStyle = ratioMap[aspectRatio] || '3 / 2';
const inlineStyles = [
  `aspect-ratio: ${aspectStyle}`,
  minHeight ? `min-height: ${minHeight}` : ''
].filter(Boolean).join('; ');
---

<div class="image-placeholder" style={inlineStyles}>
  <div class="placeholder-label">
    {label.split('\n').map((line, i, arr) => (
      <span key={i}>
        {line}
        {i < arr.length - 1 && <br />}
      </span>
    ))}
  </div>
</div>

<style>
  .image-placeholder {
    width: 100%;
    background-color: var(--color-surface-2);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    overflow: hidden;
    position: relative;
    /* Subtle inner shadow for depth without harsh borders */
    box-shadow: inset 0 0 0 1px rgba(0,0,0,0.04);
  }

  .placeholder-label {
    text-align: center;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-faint);
    opacity: 0.7;
    line-height: 1.6;
  }
</style>
