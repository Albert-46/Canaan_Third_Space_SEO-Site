---
import { SITE_CONFIG } from '../config';
---

<header class="site-header">
  <div class="container header-inner">
    <a class="site-brand" href="/" aria-label={`${SITE_CONFIG.organization.name} home page`}>
      <img src="/images/brand/Logo.png" alt={`${SITE_CONFIG.organization.name} logo`} class="site-brand-logo" width="210" height="96" />
    </a>

    <div class="header-actions">
      <a href="/contact#enquiry" class="btn btn-primary header-primary-cta">Enquire Now</a>
      
      <button class="menu-btn" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="site-nav">
        <span class="menu-btn-text">Menu</span>
        <span class="menu-icon"></span>
      </button>
    </div>

    <nav class="site-nav" id="site-nav" aria-label="Main navigation">
      <div class="site-nav-inner container">
        <div class="nav-links">
          <a href="/about" class="nav-link">About</a>
          <a href="/services" class="nav-link">Services</a>
          <a href="/contact" class="nav-link">Contact</a>
        </div>
        
        <div class="nav-contact">
          <p class="nav-contact-title">Contact Us</p>
          <a href={SITE_CONFIG.contact.phoneHref} class="nav-contact-link">{SITE_CONFIG.contact.phoneDisplay}</a>
          <a href={`mailto:${SITE_CONFIG.contact.email}`} class="nav-contact-link">{SITE_CONFIG.contact.email}</a>
          <a href="/contact#enquiry" class="btn btn-primary mt-4 w-full">Enquire Now</a>
        </div>
      </div>
    </nav>
  </div>
</header>
