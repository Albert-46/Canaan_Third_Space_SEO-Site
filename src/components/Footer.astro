---
import { SITE_CONFIG } from '../config';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand-col">
        <a class="footer-brand" href="/" aria-label={`${SITE_CONFIG.organization.name} home page`}>
          <img src="/images/brand/Logo.png" alt={`${SITE_CONFIG.organization.name} logo`} class="footer-brand-logo" />
        </a>
        <p class="footer-descriptor">
          {SITE_CONFIG.organization.name} — {SITE_CONFIG.organization.descriptor.toLowerCase()}.
        </p>
      </div>
      
      <div class="footer-nav-col">
        <h4 class="footer-heading">Navigation</h4>
        <ul class="footer-links">
          <li><a href="/about">About</a></li>
          <li><a href="/services">Services</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/privacy">Privacy</a></li>
        </ul>
      </div>
      
      <div class="footer-contact-col">
        <h4 class="footer-heading">Contact</h4>
        <ul class="footer-links">
          <li>
            <a href={SITE_CONFIG.contact.phoneHref}>{SITE_CONFIG.contact.phoneDisplay}</a>
          </li>
          {SITE_CONFIG.features.enableWhatsAppAction && (
            <li>
              <a href={SITE_CONFIG.contact.whatsappHref} target="_blank" rel="noopener noreferrer">
                WhatsApp
              </a>
            </li>
          )}
          <li>
            <a href={`mailto:${SITE_CONFIG.contact.email}`}>{SITE_CONFIG.contact.email}</a>
          </li>
          <li style="line-height: 1.5; opacity: 0.7; font-size: var(--text-xs);">
            {SITE_CONFIG.contact.addressLine2}, {SITE_CONFIG.contact.addressLine1},<br />
            {SITE_CONFIG.contact.city}, {SITE_CONFIG.contact.district} – {SITE_CONFIG.contact.postalCode}
          </li>
          <li style="margin-top: var(--spacing-sm);">
            <a href={SITE_CONFIG.contact.mapUrl} target="_blank" rel="noopener noreferrer" class="thin-rule" style="color: var(--white); border-color: var(--white);">Get Directions &rarr;</a>
          </li>
          <li style="margin-top: var(--spacing-sm);">
            <a href="/contact" class="thin-rule" style="color: var(--white); border-color: var(--white);">Enquiry Form &rarr;</a>
          </li>
        </ul>
      </div>
    </div>
    
    <div class="footer-bottom">
      <p>&copy; {currentYear} {SITE_CONFIG.organization.name}. All rights reserved.</p>
      <div class="footer-legal-links">
        <a href="/privacy">Privacy Policy</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-text);
    color: rgba(250, 249, 246, 0.7);
    padding: var(--space-20) 0 var(--space-8);
    font-size: var(--text-sm);
  }
  .site-footer a {
    color: rgba(250, 249, 246, 0.7);
    transition: color 0.2s ease, opacity 0.2s ease;
  }
  .site-footer a:hover {
    color: var(--white);
    opacity: 1;
  }
  
  .footer-top {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-12);
    margin-bottom: var(--space-16);
  }
  
  .footer-brand {
    display: block;
    width: 180px;
    margin-bottom: var(--space-6);
  }
  .footer-brand-logo {
    width: 100%;
    height: auto;
  }
  .footer-descriptor {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    opacity: 0.9;
    max-width: 320px;
    line-height: 1.4;
  }
  
  .footer-heading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-secondary);
    margin-bottom: var(--space-6);
    font-weight: 600;
  }
  
  .footer-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: var(--space-6);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--text-xs);
    opacity: 0.8;
  }
  
  @media (max-width: 768px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--spacing-sm);
    }
  }
</style>
