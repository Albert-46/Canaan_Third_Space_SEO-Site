---
import { SITE_CONFIG } from '../config';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand-col">
        <a class="footer-brand" href="/" aria-label={`${SITE_CONFIG.organization.name} home page`}>
          <img src="/images/brand/Logo.png" alt={`${SITE_CONFIG.organization.name} logo`} class="footer-brand-logo" />
        </a>
        <div class="footer-brand-text">
          <p class="footer-brand-name">{SITE_CONFIG.organization.name}</p>
          <p class="footer-brand-tagline">{SITE_CONFIG.organization.descriptor.toLowerCase()}.</p>
        </div>
      </div>
      
      <div class="footer-nav-col">
        <h4 class="footer-heading">Navigation</h4>
        <ul class="footer-links footer-nav-links">
          <li><a href="/about">About</a></li>
          <li><a href="/services">Services</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/privacy">Privacy</a></li>
        </ul>
      </div>
      
      <div class="footer-contact-col">
        <h4 class="footer-heading">Contact</h4>
        <ul class="footer-links">
          <li>
            <a href={SITE_CONFIG.contact.phoneHref}>{SITE_CONFIG.contact.phoneDisplay}</a>
          </li>
          {SITE_CONFIG.features.enableWhatsAppAction && (
            <li>
              <a href={SITE_CONFIG.contact.whatsappHref} target="_blank" rel="noopener noreferrer">
                WhatsApp
              </a>
            </li>
          )}
          <li>
            <a href={`mailto:${SITE_CONFIG.contact.email}`}>{SITE_CONFIG.contact.email}</a>
          </li>
          <li class="footer-address">
            {SITE_CONFIG.contact.addressLine2}, {SITE_CONFIG.contact.addressLine1},<br />
            {SITE_CONFIG.contact.city}, {SITE_CONFIG.contact.district} – {SITE_CONFIG.contact.postalCode}
          </li>
          <li style="margin-top: var(--spacing-sm);">
            <a href={SITE_CONFIG.contact.mapUrl} target="_blank" rel="noopener noreferrer" class="thin-rule footer-action-link">Get Directions &rarr;</a>
          </li>
          <li style="margin-top: var(--spacing-sm);">
            <a href="/contact" class="thin-rule footer-action-link">Enquiry Form &rarr;</a>
          </li>
        </ul>
      </div>
    </div>
    
    <div class="footer-bottom">
      <p>&copy; {currentYear} {SITE_CONFIG.organization.name}. All rights reserved.</p>
      <div class="footer-legal-links">
        <a href="/privacy">Privacy Policy</a>
      </div>
    </div>
  </div>
</footer>

<style>
  /* ─────────────────────────────────────────────────────────────
     Color contract for the dark footer background (#2C3330):
       --footer-primary   : high-contrast soft white  ~90% luminance
       --footer-secondary : comfortable warm grey      ~70% luminance
       --footer-muted     : muted, still readable      ~55% luminance
     Nothing uses opacity stacking — values are explicit.
  ───────────────────────────────────────────────────────────── */

  .site-footer {
    --footer-primary:   rgba(250, 249, 246, 0.92); /* soft off-white      */
    --footer-secondary: rgba(230, 226, 220, 0.78); /* warm readable grey  */
    --footer-muted:     rgba(210, 205, 198, 0.62); /* muted, not invisible */

    background-color: var(--color-text);
    color: var(--footer-secondary);
    padding: var(--space-12) 0 calc(var(--space-8) + var(--mobile-cta-height, 72px));
    font-size: var(--text-sm);
  }

  @media (min-width: 768px) {
    .site-footer {
      padding: var(--space-16) 0 var(--space-8);
    }
  }

  /* Links inherit secondary by default, brighten on hover */
  .site-footer a {
    color: var(--footer-secondary);
    transition: color 0.2s ease;
  }
  .site-footer a:hover {
    color: var(--footer-primary);
  }
  .site-footer a:focus-visible {
    outline: 2px solid var(--color-secondary);
    outline-offset: 2px;
  }

  /* ── Layout ──────────────────────────────────────────────── */

  /* Mobile: single column */
  .footer-top {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    margin-bottom: var(--space-8);
  }

  /* Desktop: wide 3-column grid */
  @media (min-width: 768px) {
    .footer-top {
      display: grid;
      grid-template-columns: 2fr 1fr 1.5fr;
      gap: var(--space-16);
      margin-bottom: var(--space-12);
      align-items: start;
    }
  }

  /* ── Brand column ────────────────────────────────────────── */
  .footer-brand-col {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-4);
  }

  .footer-brand {
    display: block;
    width: 120px;
    flex-shrink: 0;
    margin-bottom: 0;
  }
  .footer-brand-logo {
    width: 100%;
    height: auto;
  }

  .footer-brand-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .footer-brand-name {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--footer-primary);
    line-height: 1.2;
    margin: 0;
  }

  /* Brand descriptor — primary contrast, clearly readable */
  .footer-brand-tagline {
    font-size: var(--text-xs);
    color: var(--footer-muted);
    line-height: 1.4;
    margin: 0;
  }

  @media (min-width: 768px) {
    .footer-brand-col {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }
    .footer-brand {
      width: 160px;
    }
    .footer-brand-name {
      font-size: var(--text-base);
      line-height: 1.4;
      max-width: 340px;
    }
  }

  /* ── Section headings (Navigation, Contact) ─────────────── */
  .footer-heading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-secondary); /* warm peach/gold accent — unchanged */
    margin-bottom: var(--space-5);
    font-weight: 600;
  }

  /* ── Nav and contact link lists ──────────────────────────── */
  .footer-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* Mobile enhanced touch targets for main nav */
  .footer-nav-links {
    gap: 0;
  }
  .footer-nav-links li {
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }
  .footer-nav-links li:last-child {
    border-bottom: none;
  }
  .footer-nav-links a {
    display: flex;
    align-items: center;
    min-height: 44px; /* comfortable touch target */
    padding: var(--space-2) 0;
  }

  @media (min-width: 768px) {
    .footer-nav-links {
      gap: var(--space-3);
    }
    .footer-nav-links li {
      border-bottom: none;
    }
    .footer-nav-links a {
      min-height: auto;
      padding: 0;
      display: inline-block;
    }
  }

  /* Address block — secondary, not muted into invisibility */
  .footer-address {
    font-size: var(--text-xs);
    color: var(--footer-secondary);
    line-height: 1.6;
  }

  /* Action links (Get Directions, Enquiry Form) — override thin-rule's dark border */
  .footer-action-link {
    color: var(--footer-secondary);
    border-bottom-color: var(--footer-secondary) !important;
  }
  .footer-action-link:hover {
    color: var(--footer-primary);
    border-bottom-color: var(--footer-primary) !important;
  }

  /* ── Footer bottom bar ───────────────────────────────────── */
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-size: var(--text-xs);
    /* Explicit muted color — no opacity stacking */
    color: var(--footer-muted);
  }
  /* Copyright link (Privacy Policy) inherits muted but gets secondary on hover */
  .footer-bottom a {
    color: var(--footer-muted);
  }
  .footer-bottom a:hover {
    color: var(--footer-primary);
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
