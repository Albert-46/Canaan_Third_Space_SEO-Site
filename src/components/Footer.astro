---
import { SITE_CONFIG } from '../config';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand-col">
        <a class="footer-brand" href="/" aria-label={`${SITE_CONFIG.organization.name} home page`}>
          <img src="/images/brand/Logo.png" alt={`${SITE_CONFIG.organization.name} logo`} class="footer-brand-logo" />
        </a>
        <p class="footer-descriptor">
          {SITE_CONFIG.organization.name} — {SITE_CONFIG.organization.descriptor.toLowerCase()}.
        </p>
      </div>
      
      <div class="footer-nav-col">
        <h4 class="footer-heading">Navigation</h4>
        <ul class="footer-links">
          <li><a href="/about">About Us</a></li>
          <li><a href="/services">Medical Services</a></li>
          <li><a href="/senior-living">Senior Care Home</a></li>
          <li><a href="/facilities">Facilities</a></li>
          {SITE_CONFIG.features.enableTeamSection && <li><a href="/team">Care Team</a></li>}
          <li><a href="/patient-info">Patient Information</a></li>
        </ul>
      </div>
      
      <div class="footer-contact-col">
        <h4 class="footer-heading">Contact</h4>
        <ul class="footer-links">
          {SITE_CONFIG.contact.phoneDisplay && !SITE_CONFIG.contact.phoneDisplay.includes('REPLACE_WITH') && (
            <li><a href={`tel:${SITE_CONFIG.contact.phoneHref}`}>{SITE_CONFIG.contact.phoneDisplay}</a></li>
          )}
          {SITE_CONFIG.contact.email && !SITE_CONFIG.contact.email.includes('REPLACE_WITH') && (
            <li><a href={`mailto:${SITE_CONFIG.contact.email}`}>{SITE_CONFIG.contact.email}</a></li>
          )}
          <li style="margin-top: var(--spacing-sm);"><a href="/contact" class="thin-rule" style="color: var(--mineral-white); border-color: var(--mineral-white);">Enquiry Form &rarr;</a></li>
        </ul>
      </div>
    </div>
    
    <div class="footer-bottom">
      <p>&copy; {currentYear} {SITE_CONFIG.organization.name}. All rights reserved.</p>
      <div class="footer-legal-links">
        <a href="/privacy">Privacy Policy</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--deep-ink);
    color: var(--mineral-white);
    padding: var(--spacing-2xl) 0 var(--spacing-md);
    font-size: var(--text-sm);
  }
  .site-footer a {
    color: var(--mineral-white);
    opacity: 0.8;
    transition: var(--transition-smooth);
  }
  .site-footer a:hover {
    color: var(--white);
    opacity: 1;
  }
  
  .footer-top {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--spacing-xl);
    margin-bottom: var(--spacing-2xl);
  }
  
  .footer-brand {
    display: block;
    width: 180px;
    margin-bottom: var(--spacing-md);
  }
  .footer-brand-logo {
    width: 100%;
    height: auto;
  }
  .footer-descriptor {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    opacity: 0.7;
    max-width: 320px;
    line-height: 1.4;
  }
  
  .footer-heading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--brass);
    margin-bottom: var(--spacing-md);
    font-weight: 600;
  }
  
  .footer-links {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }
  
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: var(--spacing-md);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--text-xs);
    opacity: 0.6;
  }
  
  @media (max-width: 768px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--spacing-sm);
    }
  }
</style>
