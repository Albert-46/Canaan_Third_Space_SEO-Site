---
import { SITE_CONFIG } from '../config';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div style="grid-column: span 2;">
        <a class="footer-brand" href="/" aria-label={`${SITE_CONFIG.organization.name} home page`}>
          <img src="/images/brand/Logo.png" alt={`${SITE_CONFIG.organization.name} logo`} class="footer-brand-logo" />
        </a>
        <p style="font-size: var(--text-sm); opacity: 0.8; max-width: 300px; margin-bottom: var(--spacing-md);">
          {SITE_CONFIG.organization.name} — {SITE_CONFIG.organization.descriptor.toLowerCase()}.
        </p>
      </div>
      <div>
        <h4 class="footer-heading">Navigation</h4>
        <ul class="footer-links">
          <li><a href="/about">About Us</a></li>
          <li><a href="/services">Medical Services</a></li>
          <li><a href="/senior-living">Senior Care Home</a></li>
          <li><a href="/facilities">Facilities</a></li>
          {SITE_CONFIG.features.enableTeamSection && <li><a href="/team">Care Team</a></li>}
          <li><a href="/patient-info">Patient Information</a></li>
        </ul>
      </div>
      <div>
        <h4 class="footer-heading">Contact</h4>
        <ul class="footer-links">
          {SITE_CONFIG.contact.phoneDisplay && !SITE_CONFIG.contact.phoneDisplay.includes('REPLACE_WITH') && (
            <li><a href={`tel:${SITE_CONFIG.contact.phoneHref}`}>Phone: {SITE_CONFIG.contact.phoneDisplay}</a></li>
          )}
          {SITE_CONFIG.contact.email && !SITE_CONFIG.contact.email.includes('REPLACE_WITH') && (
            <li><a href={`mailto:${SITE_CONFIG.contact.email}`}>Email: {SITE_CONFIG.contact.email}</a></li>
          )}
          <li><a href="/contact">Contact &amp; Enquiry Form</a></li>
          <li><a href="/privacy">Privacy Policy</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; {currentYear} {SITE_CONFIG.organization.name}. All rights reserved.</p>
    </div>
  </div>
</footer>
