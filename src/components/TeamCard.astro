---
import type { TeamMember } from '../content/team';

export interface Props {
  member: TeamMember;
}

const { member } = Astro.props;
---

<div class="team-card reveal">
  <div class="team-image-wrapper">
    <img src={member.image} alt={`Photo of ${member.name}`} width="400" height="400" loading="lazy" />
  </div>
  <div class="team-info">
    <h3 style="font-size: var(--text-lg); margin-bottom: 5px;">{member.name}</h3>
    <p style="font-size: var(--text-sm); color: var(--muted-teal); font-weight: 500; margin-bottom: 5px;">{member.role}</p>
    <p style="font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.05em; opacity: 0.8; margin-bottom: var(--spacing-sm);">{member.qualifications}</p>
    <p style="font-size: var(--text-sm);">{member.bio}</p>
  </div>
</div>

<style>
  .team-card {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--soft-gray);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .team-image-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--soft-gray);
  }
  .team-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .team-card:hover .team-image-wrapper img {
    transform: scale(1.05);
  }
  .team-info {
    padding: var(--spacing-md);
  }
</style>
