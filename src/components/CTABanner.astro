---
import { SITE_CONFIG } from '../config';

export interface Props {
  title?: string;
  subtitle?: string;
  primaryLink?: string;
  primaryText?: string;
  secondaryLink?: string;
  secondaryText?: string;
  align?: 'center' | 'left';
}

const {
  title = "Speak with our team about care.",
  subtitle = "Whether you need to schedule a medical consultation or arrange an admission visit to our senior care home, we are here to help.",
  primaryLink = "/contact#enquiry",
  primaryText = "Enquire Online",
  secondaryLink,
  secondaryText,
  align = 'center'
} = Astro.props;
---

<section class="section cta-banner">
  <div class="container">
    <div class="cta-inner reveal">
      <div class="cta-content">
        <h2>{title}</h2>
        <p>{subtitle}</p>
        
        {SITE_CONFIG.contact.phoneDisplay && (
          <div class="cta-contact-detail">
            <span class="eyebrow">Direct Line</span>
            <a href={SITE_CONFIG.contact.phoneHref} class="cta-phone">{SITE_CONFIG.contact.phoneDisplay}</a>
          </div>
        )}

        <div class="cta-actions">
          <a href={primaryLink} class="btn btn-primary">{primaryText}</a>
          {secondaryLink && secondaryText && (
            <a href={secondaryLink} class="btn btn-secondary">{secondaryText}</a>
          )}
          {!secondaryLink && (
             <a href="/contact" class="thin-rule cta-secondary-action">View all contact details &rarr;</a>
          )}
          {SITE_CONFIG.features.enableWhatsAppAction && (
            <a href={SITE_CONFIG.contact.whatsappHref} class="thin-rule cta-secondary-action" target="_blank" rel="noopener noreferrer">WhatsApp &rarr;</a>
          )}
        </div>
      </div>
      <div class="cta-image-wrapper">
         <img src="/images/third-space/hero/third-space-exterior-main.jpeg" alt="Third Space Senior Care Home exterior" class="cta-image" loading="lazy" decoding="async" />
      </div>
    </div>
  </div>
</section>

<style>
  .cta-banner {
    padding-bottom: var(--spacing-2xl);
  }
  .cta-inner {
    background-color: var(--color-surface-2);
    display: flex;
    overflow: hidden;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }
  .cta-content {
    flex: 1;
    padding: var(--spacing-2xl) var(--spacing-xl);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .cta-content h2 {
    font-size: var(--text-4xl);
    color: var(--color-text);
    margin-bottom: var(--spacing-md);
  }
  .cta-content p {
    font-size: var(--text-lg);
    color: var(--color-text);
    opacity: 0.85;
    max-width: 500px;
    margin-bottom: var(--spacing-xl);
  }
  .cta-contact-detail {
    margin-bottom: var(--spacing-lg);
  }
  .cta-contact-detail .eyebrow {
    color: var(--color-text);
    opacity: 0.7;
  }
  .cta-phone {
    font-size: var(--text-2xl);
    font-family: var(--font-display);
    color: var(--color-text);
  }
  .cta-actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    flex-wrap: wrap;
  }
  .cta-secondary-action {
    color: var(--color-text);
    border-bottom-color: rgba(44, 51, 48, 0.3);
  }
  
  .cta-image-wrapper {
    flex: 0.8;
    position: relative;
    min-height: 400px;
  }
  .cta-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .cta-inner {
      flex-direction: column;
    }
    .cta-image-wrapper {
      min-height: 300px;
      order: -1;
    }
    .cta-content {
      padding: var(--spacing-xl) var(--spacing-md);
    }
  }
</style>
